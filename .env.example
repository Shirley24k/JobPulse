# Backend authentication
AUTH_USERNAME=your-username
AUTH_PASSWORD_HASH=generate-with-npm-run-generate-password-hash
SESSION_SECRET=replace-with-a-long-random-secret

# Public frontend URL (use your Netlify URL in production)
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5000

# Optional existing email settings
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
